FLASK_APP=run.py
APP_CONFIG=development
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-local-random-secret
DATABASE_URL=sqlite:///teamflow.db
TEST_DATABASE_URL=sqlite:///:memory:
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# Workspace invitation email delivery. Development and testing use the explicit
# in-memory outbox (no email is sent). Real email needs INVITATION_EMAIL_PROVIDER to be
# `smtp` (Gmail or any SMTP server) or `resend` (needs a verified sending domain).
# Production must use `smtp` or `resend`. This file holds PLACEHOLDERS ONLY: put real
# values in backend/.env, which is git-ignored. Never commit real credentials.
INVITATION_EMAIL_PROVIDER=development
INVITATION_EMAIL_FROM=TeamFlow <no-reply@example.invalid>
RESEND_API_KEY=replace-with-a-resend-api-key
INVITATION_EMAIL_TIMEOUT_SECONDS=10

# --- Real email through Gmail (or any SMTP server) ---
# To use it, set INVITATION_EMAIL_PROVIDER=smtp in backend/.env and replace every
# placeholder below. For Gmail: turn on 2-Step Verification, create an App Password
# (Google Account > Security > App passwords) and paste it as SMTP_PASSWORD (the spaces
# Google shows are ignored). INVITATION_EMAIL_FROM must be the SAME Gmail address as
# SMTP_USERNAME (or a verified "Send mail as" alias).
# Also change INVITATION_EMAIL_FROM above, for example: TeamFlow <your-address@gmail.com>
# These values are ignored unless INVITATION_EMAIL_PROVIDER=smtp, and the placeholders
# below are rejected at startup so they can never be used by mistake.
# Port 587 uses starttls and port 465 uses ssl; certificates are always verified.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=replace-with-a-gmail-app-password

# For PostgreSQL development, replace DATABASE_URL with:
# postgresql+psycopg://teamflow_user@localhost:5432/teamflow_dev
